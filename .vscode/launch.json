		},
		{
			"name": "Generate Pygame App",
			"type": "debugpy",
			"request": "launch",
			"module": "src.main",
			"cwd": "${workspaceFolder}",
			"console": "integratedTerminal",
			"args": ["--dir", ".", "--type", "tkinter", "--name", "PyProGen", "--publisher", "DeepThoughtt", "--verbose"]
